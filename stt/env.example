# STT / Frontend Environment Configuration
# Copy this file to .env and fill in your values.

# === REQUIRED API CONFIGURATION ===
API_URL=http://<YOUR_API_SERVER_IP>:8080/api/chat
LLM_MODEL=llama3.2:8b-instruct-q4_K_M

# === ELEVENLABS (used by utilities/generate_filler_audio.py) ===
# Required when regenerating filler audio files.  Never hardcode these values.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# === AUDIO CONFIGURATION ===
SPEECH_RATE=200               # 150 for Pi, 200 for Mac/Windows
AUDIO_PLAYER=afplay           # afplay (Mac), aplay (Pi), mpg123 (Windows)

# === PERFORMANCE SETTINGS ===
TIMEOUT=90                    # 60 for Pi, 90 for Mac/Windows
WAIT_INTERVAL=3               # 5 for Pi, 3 for Mac/Windows

# === STT CONFIGURATION ===
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
SAMPLE_RATE=16000
MIC_DEVICE=default            # See list_audio_devices.py for device names
BLOCKSIZE=8000                # 4000 for Pi, 8000 for Mac/Windows

# === MICROPHONE VOLUME ===
MIC_VOLUME=150%               # 0%-200% (integer percentage only)

# === BLUETOOTH SPEAKER (optional) ===
BLUETOOTH_SPEAKER=            # MAC address format: AA:BB:CC:DD:EE:FF
BLUETOOTH_PIN=                # Pairing PIN (do not use default 1234 if avoidable)

# === SKELETON INTEGRATION (optional) ===
# BLE Control Interface — Home Depot "Animated Skelly"
SKELETON_BLE_ADDRESS=         # BLE control MAC (format: AA:BB:CC:DD:EE:FF)
SKELETON_AUDIO_BLE_ADDRESS=   # Classic BT audio MAC (format: AA:BB:CC:DD:EE:FF)
SKELETON_AUDIO_PIN=           # Classic BT pairing PIN
SKELETON_MOVEMENT_ENABLED=true
SKELETON_MOVEMENT_COOLDOWN=10

# === FILLER PHRASES ===
FILLER_ENABLED=true

# === AMBIENT AUDIO ===
AMBIENT_ENABLED=true
AMBIENT_VOLUME=0.3            # 0.0 to 1.0
